{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "scai_members"
  },
  "Jwt": {
    "Issuer": "ScaiMembers",
    "Audience": "ScaiMembers",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "https://members.scai.world" ]
  },
  "Upload": {
    "Path": "/app/uploads",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".pdf", ".html" ]
  }
}
