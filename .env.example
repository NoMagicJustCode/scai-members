# --- scai-members server environment ---
# Copy to .env on the VPS and fill in.

# Session signing secret — random string, minimum 32 characters. Keep stable
# (changing it signs everyone out). The backend refuses to start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Transactional email (verification, application results, GV invitations).
# Required in production: without SMTP_HOST the application form answers 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=members@scai.world
